<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wavw.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wavw.Views"
    Shell.FlyoutBehavior="Disabled">


    <ShellContent
        Title="Sign Up"
        ContentTemplate="{DataTemplate local:SignUpPage}"
        Route="SignUpPage" />
    <ShellContent
        Title="Sign Up"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="SignUpPage" />


    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Popular Beaches"
        ContentTemplate="{DataTemplate local:PopularBeachesPage}"
        Route="PopularBeachesPage" />

    <ShellContent
        Title="Map"
        ContentTemplate="{DataTemplate local:HomePage}"
        Route="HomePage" />

    <ShellContent
        Title="Weather"
        ContentTemplate="{DataTemplate local:WeatherPage}"
        Route="WeatherPage" />

</Shell>
