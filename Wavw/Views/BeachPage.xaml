<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.BeachPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Wavw.Converters"
    Title="{Binding Beach.Name}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToListConverter x:Key="StringToListConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!-- Beach Image with Gradient Overlay -->
                <Grid HeightRequest="300">
                    <Image
                        Aspect="AspectFill"
                        Source="{Binding Beach.ImageUrl}"
                        HeightRequest="300"/>
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.6" Color="Transparent"/>
                                <GradientStop Offset="1.0" Color="White"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    
                    <!-- Back Button -->
                    <Button
                        Text="&#x2190;"
                        FontSize="24"
                        BackgroundColor="#80FFFFFF"
                        CornerRadius="20"
                        HeightRequest="40"
                        WidthRequest="40"
                        Margin="20,40,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Clicked="OnBackButtonClicked"/>
                </Grid>

                <!-- Beach Details -->
                <VerticalStackLayout Spacing="20" Padding="20" Margin="0,-40,0,0">
                    <!-- Beach Name and Rating -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Beach.Name}"
                            FontSize="32"
                            FontAttributes="Bold"
                            TextColor="#1B4965"/>
                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">
                            <Label
                                Text="&#xE838;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                TextColor="#FFD700"/>
                            <Label
                                Text="{Binding Beach.Rating}"
                                FontSize="20"
                                TextColor="#FFD700"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Location -->
                    <HorizontalStackLayout Spacing="10">
                        <Label
                            Text="&#xE55F;"
                            FontFamily="{StaticResource MaterialIconsFont}"
                            FontSize="24"
                            TextColor="#1B4965"
                            VerticalOptions="Center"/>
                        <Label
                            Text="{Binding Beach.City}"
                            FontSize="18"
                            TextColor="#1B4965"
                            VerticalOptions="Center"/>
                        <Label
                            Text=", "
                            FontSize="18"
                            TextColor="#1B4965"
                            VerticalOptions="Center"/>
                        <Label
                            Text="{Binding Beach.State}"
                            FontSize="18"
                            TextColor="#1B4965"
                            VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Cleanliness -->
                    <Frame
                        BackgroundColor="#F0F7F9"
                        Padding="15"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                Text="&#xE3F7;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                            <Label
                                Text="{Binding Beach.Cleanliness, StringFormat='Cleanliness: {0}/5'}"
                                FontSize="16"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Best Season -->
                    <Frame
                        BackgroundColor="#F0F7F9"
                        Padding="15"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                Text="&#xE2C7;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                            <Label
                                Text="{Binding Beach.BestSeason, StringFormat='Best Season: {0}'}"
                                FontSize="16"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- View on Map -->
                    <Frame
                        BackgroundColor="#F0F7F9"
                        Padding="15"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                Text="&#xE55F;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                            <Label
                                Text="View on Map"
                                FontSize="16"
                                TextColor="#1B4965"
                                VerticalOptions="Center"/>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewOnMapClicked"/>
                            </Frame.GestureRecognizers>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Main Attractions -->
                    <Label
                        Text="Main Attractions"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#1B4965"
                        Margin="0,10,0,0"/>
                    <CollectionView
                        ItemsSource="{Binding Beach.MainAttractions, Converter={StaticResource StringToListConverter}}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10" Margin="0,5">
                                    <Label 
                                        Text="•" 
                                        FontSize="16" 
                                        TextColor="#1B4965" 
                                        VerticalOptions="Start"/>
                                    <Label 
                                        Text="{Binding .}" 
                                        FontSize="16" 
                                        TextColor="#1B4965"
                                        LineBreakMode="WordWrap"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" BackgroundColor="White" HeightRequest="60">
            <!-- Home -->
            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE88A;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Home"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Weather -->
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE2BD;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWeatherCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Weather"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Map -->
            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE55B;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Map"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>