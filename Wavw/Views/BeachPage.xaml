<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="Wavw.Views.BeachPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Wavw.Models"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,40,16,16" ColumnDefinitions="Auto,*,Auto">
            <!-- Back Button -->
            <Label 
                Grid.Column="0"
                Text="&#xE5C4;"
                FontFamily="{StaticResource MaterialIconsFont}"
                FontSize="24"
                TextColor="Black"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                </Label.GestureRecognizers>
            </Label>
            
            <!-- Title -->
            <Label 
                Grid.Column="1"
                Text="Beach Details"
                FontSize="18"
                TextColor="Black"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
            
            <!-- Share Button -->
            <Label 
                Grid.Column="2"
                Text="&#xE80D;"
                FontFamily="{StaticResource MaterialIconsFont}"
                FontSize="24"
                TextColor="Black"
                VerticalOptions="Center"/>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Margin="0,0,0,60">
            <VerticalStackLayout Spacing="0">
                <!-- Beach Image -->
                <Grid HeightRequest="200">
                    <Image 
                        x:Name="BeachImage"
                        Source="https://images.unsplash.com/photo-1507525428034-b723cf961d3e"
                        Aspect="AspectFill"/>
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.5" Color="Transparent"/>
                                <GradientStop Offset="1.0" Color="#AA000000"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <!-- Beach Title Overlay -->
                    <VerticalStackLayout
                        Spacing="4"
                        Padding="16"
                        VerticalOptions="End">
                        <Label 
                            x:Name="BeachNameLabel"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"/>
                        <Label 
                            x:Name="LocationLabel"
                            TextColor="White"
                            FontSize="16"
                            Opacity="0.9"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Rating Section -->
                <HorizontalStackLayout Spacing="4" Margin="16,12">
                    <Label 
                        Text="&#xE838;"
                        FontFamily="{StaticResource MaterialIconsFont}"
                        TextColor="#FFD700"
                        FontSize="16"
                        VerticalOptions="Center"/>
                    <Label 
                        x:Name="RatingLabel"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#FFD700"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Location Details -->
                <Grid ColumnDefinitions="*,*" Margin="16,0">
                    <!-- State -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="State" FontSize="12" TextColor="Gray"/>
                        <HorizontalStackLayout Spacing="4">
                            <Label 
                                Text="&#xE55F;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="16"
                                TextColor="Black"
                                VerticalOptions="Center"/>
                            <Label 
                                x:Name="StateLabel"
                                FontSize="14" 
                                TextColor="Black"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <!-- City -->
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="City" FontSize="12" TextColor="Gray"/>
                        <HorizontalStackLayout Spacing="4">
                            <Label 
                                Text="&#xE55F;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="16"
                                TextColor="Black"
                                VerticalOptions="Center"/>
                            <Label 
                                x:Name="CityLabel"
                                FontSize="14" 
                                TextColor="Black"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Additional Details -->
                <Grid ColumnDefinitions="*,*" Margin="16,16,16,0">
                    <!-- Cleanliness -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <HorizontalStackLayout Spacing="4">
                            <Label 
                                Text="&#xE0B8;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="16"
                                TextColor="Gray"
                                VerticalOptions="Center"/>
                            <Label Text="Cleanliness" FontSize="12" TextColor="Gray"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <BoxView 
                                WidthRequest="6" 
                                HeightRequest="6" 
                                CornerRadius="3"
                                BackgroundColor="#4CAF50"
                                VerticalOptions="Center"/>
                            <Label 
                                x:Name="CleanlinessLabel"
                                FontSize="14" 
                                TextColor="Black"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <!-- Best Season -->
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <HorizontalStackLayout Spacing="4">
                            <Label 
                                Text="&#xE8DF;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="16"
                                TextColor="Gray"
                                VerticalOptions="Center"/>
                            <Label Text="Best Season" FontSize="12" TextColor="Gray"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label 
                                x:Name="BestSeasonLabel"
                                FontSize="14" 
                                TextColor="Black"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Main Attractions -->
                <VerticalStackLayout Margin="16,24,16,0" Spacing="12">
                    <Label 
                        Text="Main Attractions"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="Black"/>
                    
                    <VerticalStackLayout 
                        x:Name="AttractionsLayout"
                        Spacing="12"/>
                </VerticalStackLayout>

                <!-- Map Section -->
                <Frame 
                    Margin="16,16,16,0"
                    Padding="0"
                    HeightRequest="120"
                    CornerRadius="8"
                    BorderColor="Transparent"
                    IsClippedToBounds="True">
                    <Grid>
                        <Image 
                            Source="map_placeholder.png"
                            Aspect="AspectFill"/>
                        <Button 
                            Text="View on Map"
                            TextColor="#1B4965"
                            BackgroundColor="White"
                            CornerRadius="16"
                            HeightRequest="32"
                            WidthRequest="100"
                            FontSize="12"
                            Clicked="OnViewMapClicked"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Weather Button Section -->
                <Button 
                    Margin="16,16,16,16"
                    Text="Check Weather"
                    TextColor="White"
                    BackgroundColor="#1B4965"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="16"
                    Clicked="OnCheckWeatherClicked"
                    FontAttributes="Bold"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Border 
            Grid.Row="2"
            BackgroundColor="White"
            Stroke="#E0E0E0"
            StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,-1"
                        Opacity="0.1"
                        Radius="4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*" 
                  HeightRequest="60" 
                  Padding="0,8,0,8">
                <!-- Home -->
                <VerticalStackLayout 
                    Grid.Column="0" 
                    Spacing="4" 
                    VerticalOptions="Center">
                    <Label 
                        Text="&#xE88A;"
                        FontFamily="{StaticResource MaterialIconsFont}"
                        TextColor="#1B4965"
                        FontSize="24"
                        HorizontalOptions="Center"/>
                    <Label 
                        Text="Home"
                        TextColor="#1B4965"
                        FontSize="12"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Weather -->
                <VerticalStackLayout 
                    Grid.Column="1" 
                    Spacing="4" 
                    VerticalOptions="Center">
                    <Label 
                        Text="&#xE2BD;"
                        FontFamily="{StaticResource MaterialIconsFont}"
                        TextColor="#1B4965"
                        FontSize="24"
                        HorizontalOptions="Center"/>
                    <Label 
                        Text="Weather"
                        TextColor="#1B4965"
                        FontSize="12"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Map -->
                <VerticalStackLayout 
                    Grid.Column="2" 
                    Spacing="4" 
                    VerticalOptions="Center">
                    <Label 
                        Text="&#xE55B;"
                        FontFamily="{StaticResource MaterialIconsFont}"
                        TextColor="#1B4965"
                        FontSize="24"
                        HorizontalOptions="Center"/>
        <Label 
                        Text="Map"
                        TextColor="#1B4965"
                        FontSize="12"
                        HorizontalOptions="Center"/>
    </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>