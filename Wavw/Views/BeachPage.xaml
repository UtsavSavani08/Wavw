<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.BeachPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Wavw.Converters"
    Title="{Binding Beach.Name}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToListConverter x:Key="StringToListConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!--  Beach Image with Gradient Overlay  -->
                <Grid HeightRequest="300">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="300"
                        Source="{Binding Beach.ImageUrl}" />
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.6" Color="Transparent" />
                                <GradientStop Offset="1.0" Color="White" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!--  Back Button  -->
                    <Button
                        Margin="20,40,0,0"
                        BackgroundColor="#80FFFFFF"
                        Clicked="OnBackButtonClicked"
                        CornerRadius="20"
                        FontSize="24"
                        HeightRequest="40"
                        HorizontalOptions="Start"
                        Text="&#x2190;"
                        VerticalOptions="Start"
                        WidthRequest="40" />
                </Grid>

                <!--  Beach Details  -->
                <VerticalStackLayout
                    Margin="0,-40,0,0"
                    Padding="20"
                    Spacing="20">
                    <!--  Beach Name and Rating  -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="32"
                            Text="{Binding Beach.Name}"
                            TextColor="#1B4965" />
                        <HorizontalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE838;"
                                TextColor="#FFD700" />
                            <Label
                                FontSize="20"
                                Text="{Binding Beach.Rating}"
                                TextColor="#FFD700" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!--  Location  -->
                    <HorizontalStackLayout Spacing="10">
                        <Label
                            FontFamily="{StaticResource MaterialIconsFont}"
                            FontSize="24"
                            Text="&#xE55F;"
                            TextColor="#1B4965"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="18"
                            Text="{Binding Beach.City}"
                            TextColor="#1B4965"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="18"
                            Text=", "
                            TextColor="#1B4965"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="18"
                            Text="{Binding Beach.State}"
                            TextColor="#1B4965"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Cleanliness  -->
                    <Frame
                        Padding="15"
                        BackgroundColor="#F0F7F9"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE3F7;"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="16"
                                Text="{Binding Beach.Cleanliness, StringFormat='Cleanliness: {0}/5'}"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                    <!--  Best Season  -->
                    <Frame
                        Padding="15"
                        BackgroundColor="#F0F7F9"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE2C7;"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="16"
                                Text="{Binding Beach.BestSeason, StringFormat='Best Season: {0}'}"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                    <!--  View on Map  -->
                    <Frame
                        Padding="15"
                        BackgroundColor="#F0F7F9"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE55F;"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="16"
                                Text="View on Map"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewOnMapClicked" />
                            </Frame.GestureRecognizers>
                        </HorizontalStackLayout>
                    </Frame>
                    <!--  Check Weather  -->
                    <Frame
                        Padding="15"
                        BackgroundColor="#F0F7F9"
                        CornerRadius="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE2BD;"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Label
                                FontSize="16"
                                Text="Check Weather"
                                TextColor="#1B4965"
                                VerticalOptions="Center" />
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClickCheckWeather" />
                            </Frame.GestureRecognizers>
                        </HorizontalStackLayout>
                    </Frame>

                    <!--  Main Attractions  -->
                    <Label
                        Margin="0,10,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Main Attractions"
                        TextColor="#1B4965" />
                    <CollectionView ItemsSource="{Binding Beach.MainAttractions, Converter={StaticResource StringToListConverter}}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Margin="0,5" Spacing="10">
                                    <Label
                                        FontSize="16"
                                        Text="•"
                                        TextColor="#1B4965"
                                        VerticalOptions="Start" />
                                    <Label
                                        FontSize="16"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding .}"
                                        TextColor="#1B4965" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Bottom Navigation Bar  -->
        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            ColumnDefinitions="*,*,*"
            HeightRequest="60">
            <!--  Home  -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE88A;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Home"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Weather  -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE2BD;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWeatherCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Weather"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Map  -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE55B;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Map"
                    TextColor="#1B4965" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>