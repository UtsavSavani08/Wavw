<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Wavw.Converters"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:model="clr-namespace:Wavw.Model"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
        <x:String x:Key="CustomMapStyle">
            [
            {
            "featureType": "poi",
            "elementType": "labels",
            "stylers": [
            {
            "visibility": "off"
            }
            ]
            },
            {
            "featureType": "transit",
            "elementType": "labels",
            "stylers": [
            {
            "visibility": "off"
            }
            ]
            }
            ]
        </x:String>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Search Bar  -->
        <SearchBar
            Grid.Row="0"
            Margin="10"
            Placeholder="Search beach by name..."
            SearchCommand="{Binding SearchCommand}"
            SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" />

        <!--  Map with Location Button  -->
        <Grid Grid.Row="1">
            <maps:Map
                x:Name="BeachMap"
                IsEnabled="True"
                IsShowingUser="False"
                MapType="Street" />

            <!--  Location Button  -->
            <Button
                Grid.Row="1"
                Margin="0,0,80,20"
                Command="{Binding GetCurrentLocationCommand}"
                CornerRadius="30"
                FontSize="24"
                HeightRequest="60"
                HorizontalOptions="End"
                Text="📍"
                VerticalOptions="End"
                WidthRequest="60" />
        </Grid>

        <!--  Beach Details Popup  -->
        <Frame
            x:Name="DetailsPanel"
            Grid.Row="1"
            Margin="20"
            Padding="20"
            BackgroundColor="White"
            BorderColor="Transparent"
            CornerRadius="20"
            HasShadow="True"
            HorizontalOptions="Fill"
            IsVisible="{Binding SelectedBeach, Converter={StaticResource NotNullToBoolConverter}}"
            MaximumHeightRequest="500"
            TranslationY="300"
            VerticalOptions="Start">
            <VerticalStackLayout Spacing="16">
                <!--  Header  -->
                <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                    <Label
                        x:Name="BeachNameLabel"
                        Grid.Column="0"
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="{Binding SelectedBeach.Name}"
                        TextColor="#333333"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Padding="8"
                        BackgroundColor="Transparent"
                        Command="{Binding CloseDetailsCommand}"
                        CornerRadius="20"
                        FontSize="20"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        Text="✕"
                        TextColor="#666666"
                        VerticalOptions="Center"
                        WidthRequest="40" />
                </Grid>

                <!--  Info Grid  -->
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="12">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Location"
                        TextColor="#666666"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding SelectedBeach.City, StringFormat='{0}, '}{Binding SelectedBeach.State}"
                        TextColor="#333333"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Rating"
                        TextColor="#666666"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding SelectedBeach.Rating}"
                        TextColor="#333333"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Cleanliness"
                        TextColor="#666666"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding SelectedBeach.Cleanliness}"
                        TextColor="#333333"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Best Season"
                        TextColor="#666666"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="{Binding SelectedBeach.BestSeason}"
                        TextColor="#333333"
                        VerticalOptions="Center" />
                </Grid>

                <!--  Attractions Section  -->
                <StackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="Main Attractions"
                        TextColor="#666666" />
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding SelectedBeach.MainAttractions}"
                        TextColor="#333333" />
                </StackLayout>

                <!--  Action Buttons  -->
                <Grid
                    Margin="0,10,0,0"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        BackgroundColor="#2196F3"
                        Command="{Binding GetDirectionsCommand}"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Get Directions"
                        TextColor="White" />

                    <Button
                        Grid.Column="1"
                        BackgroundColor="#4CAF50"
                        Command="{Binding GetWeatherCommand}"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Weather Info"
                        TextColor="White" />

                </Grid>

                <Button
                    Grid.Column="2"
                    BackgroundColor="#FF9800"
                    Command="{Binding ShowBeachInfoCommand}"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="Info"
                    TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!--  Bottom Navigation Bar  -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            ColumnDefinitions="*,*,*"
            HeightRequest="60">
            <!--  Home  -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE88A;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Home"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Weather  -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE2BD;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWeatherCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Weather"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Map  -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE55B;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Map"
                    TextColor="#1B4965" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
