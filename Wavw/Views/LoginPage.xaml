<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#5FA8D3" />
            <GradientStop Offset="1.0" Color="#1B4965" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="24,48,24,0" RowDefinitions="Auto,*">
        <!--  Header  -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Image
                Margin="0,0,0,8"
                HeightRequest="60"
                HorizontalOptions="Center"
                Source="wavw_logo.png"
                WidthRequest="60" />
            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Wavw"
                TextColor="White" />
            <Label
                Margin="0,4,0,0"
                FontSize="16"
                HorizontalOptions="Center"
                Opacity="0.9"
                Text="Welcome Back"
                TextColor="#BEE9E8" />
        </VerticalStackLayout>

        <!--  Login Form  -->
        <VerticalStackLayout
            Grid.Row="1"
            Margin="0,48,0,0"
            Spacing="24">
            <!--  Email Input  -->
            <VerticalStackLayout Spacing="8">
                <Label
                    FontSize="14"
                    Opacity="0.9"
                    Text="Email"
                    TextColor="#BEE9E8" />
                <Frame
                    Padding="16,0"
                    BackgroundColor="#62B6CB"
                    BorderColor="Transparent"
                    CornerRadius="8"
                    HeightRequest="48">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry
                            x:Name="EmailEntry"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            Placeholder="Enter your email"
                            PlaceholderColor="#BEE9E8"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Column="1"
                            HeightRequest="20"
                            Source="email.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <!--  Password Input  -->
            <VerticalStackLayout Spacing="8">
                <Label
                    FontSize="14"
                    Opacity="0.9"
                    Text="Password"
                    TextColor="#BEE9E8" />
                <Frame
                    Padding="16,0"
                    BackgroundColor="#62B6CB"
                    BorderColor="Transparent"
                    CornerRadius="8"
                    HeightRequest="48">
                    <Grid ColumnDefinitions="*">
                        <Entry
                            x:Name="PasswordEntry"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            IsPassword="True"
                            Placeholder="Enter your password"
                            PlaceholderColor="#BEE9E8"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>

            <!--  Login Button  -->
            <Button
                x:Name="LoginButton"
                Margin="0,16,0,0"
                BackgroundColor="White"
                Clicked="OnLoginClicked"
                CornerRadius="8"
                FontSize="16"
                HeightRequest="48"
                Text="Login"
                TextColor="#1B4965" />

            <!--  Sign Up Link  -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label
                    Opacity="0.9"
                    Text="Don't have an account?"
                    TextColor="#BEE9E8" />
                <Label
                    FontAttributes="Bold"
                    Text="Sign Up"
                    TextColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>