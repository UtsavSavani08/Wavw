<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:Wavw.Model"
    xmlns:local="clr-namespace:Wavw.Views"
    xmlns:converters="clr-namespace:Wavw.Converters"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,60">
        <!-- Main Content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!-- Top Section with Background -->
                <Grid HeightRequest="220">
                    <!-- Background Image with Gradient -->
                    <Image
                        Aspect="AspectFill"
                        Source="https://images.unsplash.com/photo-1507525428034-b723cf961d3e" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.0" Color="#40FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Header Content -->
                    <VerticalStackLayout
                        Spacing="20"
                        Padding="20,40,20,20">
                        
                        <!-- App Title -->
                        <Label
                            Text="Wavw"
                            FontSize="32"
                            TextColor="#1B4965"
                            FontAttributes="Bold" />

                        <Label
                            Text="Explore the Indian coast!"
                            FontSize="16"
                            TextColor="#1B4965"
                            Opacity="0.8"
                            Margin="0,-15,0,0" />

                        <!-- Search Bar -->
                        <Frame
                            BackgroundColor="White"
                            CornerRadius="30"
                            Margin="0,16,0,0"
                            Padding="16,0"
                            HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label 
                                    Grid.Column="0"
                                    Text="&#xE8B6;"
                                    FontFamily="{StaticResource MaterialIconsFont}"
                                    TextColor="#1B4965"
                                    FontSize="24"
                                    VerticalOptions="Center"/>
                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding SearchText}"
                                    Placeholder="Search your dream beach"
                                    PlaceholderColor="#1B4965"
                                    TextColor="#1B4965"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>

                <!-- Popular Beaches Section -->
                <VerticalStackLayout
                    Spacing="20"
                    Padding="20,20,20,0">
                    
                    <!-- Popular Beaches Section Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Popular Beaches"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#1B4965" />
                        <Label
                            Grid.Column="1"
                            Text="See more"
                            FontSize="14"
                            TextColor="#62B6CB"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding SeeMoreCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Loading Indicator -->
                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        HeightRequest="50"
                        WidthRequest="50"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Color="#1B4965"
                        Margin="0,20,0,20" />

                    <!-- Popular Beach Cards -->
                    <CollectionView 
                        IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ItemsSource="{Binding PopularBeaches}"
                        HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:PopularBeach">
                                <Frame
                                    BackgroundColor="White"
                                    CornerRadius="10"
                                    HeightRequest="180"
                                    WidthRequest="150"
                                    Padding="0"
                                    HasShadow="True"
                                    IsClippedToBounds="True">
                                    <Grid RowDefinitions="*, Auto">
                                        <Image
                                            Grid.Row="0"
                                            Source="{Binding ImageUrl}"
                                            Aspect="AspectFill"
                                            HeightRequest="120" />
                                        <VerticalStackLayout
                                            Grid.Row="1"
                                            Padding="10,5">
                                            <Label
                                                Text="{Binding Name}"
                                                FontAttributes="Bold"
                                                FontSize="14" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    Text="&#xE55F;"
                                                    FontFamily="{StaticResource MaterialIconsFont}"
                                                    FontSize="12"
                                                    TextColor="Gray"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding City}"
                                                    FontSize="12"
                                                    TextColor="Gray" />
                                                <Label
                                                    Text=", "
                                                    FontSize="12"
                                                    TextColor="Gray" />
                                                <Label
                                                    Text="{Binding State}"
                                                    FontSize="12"
                                                    TextColor="Gray" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    Text="&#xE838;"
                                                    FontFamily="{StaticResource MaterialIconsFont}"
                                                    FontSize="12"
                                                    TextColor="#FFD700"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Text="{Binding Rating}"
                                                    FontSize="12"
                                                    TextColor="#FFD700" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=PopularBeachSelectedCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" BackgroundColor="White" HeightRequest="60">
            <!-- Home -->
            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE88A;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Home"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Weather -->
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE2BD;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWeatherCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Weather"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Map -->
            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE55B;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Map"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage> 