<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Wavw.Converters"
    xmlns:local="clr-namespace:Wavw.Views"
    xmlns:model="clr-namespace:Wavw.Model"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,60">
        <!--  Main Content  -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <!--  Top Section with Background  -->
                <Grid HeightRequest="220">
                    <!--  Background Image with Gradient  -->
                    <Image Aspect="AspectFill" Source="https://images.unsplash.com/photo-1507525428034-b723cf961d3e" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.0" Color="#40FFFFFF" />
                                <GradientStop Offset="1.0" Color="#FFFFFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!--  Header Content  -->
                    <VerticalStackLayout Padding="20,40,20,20" Spacing="20">

                        <!--  App Title  -->
                        <Label
                            FontAttributes="Bold"
                            FontSize="32"
                            Text="Wavw"
                            TextColor="#1B4965" />

                        <Label
                            Margin="0,-15,0,0"
                            FontSize="16"
                            Opacity="0.8"
                            Text="Explore the Indian coast!"
                            TextColor="#1B4965" />

                        <!--  Search Bar  -->
                        <Frame
                            Margin="0,16,0,0"
                            Padding="16,0"
                            BackgroundColor="White"
                            CornerRadius="30"
                            HeightRequest="50">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="{StaticResource MaterialIconsFont}"
                                    FontSize="24"
                                    Text="&#xE8B6;"
                                    TextColor="#1B4965"
                                    VerticalOptions="Center" />
                                <Entry
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Placeholder="Search your dream beach"
                                    PlaceholderColor="#1B4965"
                                    Text="{Binding SearchText}"
                                    TextColor="#1B4965"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>

                <!--  Popular Beaches Section  -->
                <VerticalStackLayout Padding="20,20,20,0" Spacing="20">

                    <!--  Popular Beaches Section Header  -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Popular Beaches"
                            TextColor="#1B4965" />
                        <Label
                            Grid.Column="1"
                            FontSize="14"
                            Text="See more"
                            TextColor="#62B6CB"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeMoreCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!--  Loading Indicator  -->
                    <ActivityIndicator
                        Margin="0,20,0,20"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        VerticalOptions="Center"
                        WidthRequest="50"
                        Color="#1B4965" />

                    <!--  Popular Beach Cards  -->
                    <CollectionView
                        HeightRequest="200"
                        IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        ItemsSource="{Binding PopularBeaches}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="15" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:PopularBeach">
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    CornerRadius="10"
                                    HasShadow="True"
                                    HeightRequest="180"
                                    IsClippedToBounds="True"
                                    WidthRequest="150">
                                    <Grid RowDefinitions="*, Auto">
                                        <Image
                                            Grid.Row="0"
                                            Aspect="AspectFill"
                                            HeightRequest="120"
                                            Source="{Binding ImageUrl}" />
                                        <VerticalStackLayout Grid.Row="1" Padding="10,5">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding Name}" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    FontFamily="{StaticResource MaterialIconsFont}"
                                                    FontSize="12"
                                                    Text="&#xE55F;"
                                                    TextColor="Gray"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding City}"
                                                    TextColor="Gray" />
                                                <Label
                                                    FontSize="12"
                                                    Text=", "
                                                    TextColor="Gray" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding State}"
                                                    TextColor="Gray" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    FontFamily="{StaticResource MaterialIconsFont}"
                                                    FontSize="12"
                                                    Text="&#xE838;"
                                                    TextColor="#FFD700"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding Rating}"
                                                    TextColor="#FFD700" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=PopularBeachSelectedCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Recommended Beaches"
                            TextColor="#1B4965" />
                    </Grid>

                    <!--  Loading Indicator  -->
                    <ActivityIndicator
                        Margin="0,20,0,20"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsLoadingRecommended}"
                        IsVisible="{Binding IsLoadingRecommended}"
                        VerticalOptions="Center"
                        WidthRequest="50"
                        Color="#1B4965" />

                    <!--  Recommended Beach Cards  -->
                    <CollectionView
                        HeightRequest="200"
                        IsVisible="{Binding IsLoadingRecommended, Converter={StaticResource InverseBoolConverter}}"
                        ItemsSource="{Binding RecommendedBeaches}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="15" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Beach">
                                <!-- In the Recommended Beach Cards DataTemplate -->
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    CornerRadius="10"
                                    HasShadow="True"
                                    HeightRequest="180"
                                    IsClippedToBounds="True"
                                    WidthRequest="150">
                                    <Grid RowDefinitions="*, Auto">
                                        <Image
                                            Grid.Row="0"
                                            Aspect="AspectFill"
                                            HeightRequest="120"
                                            Source="{Binding ImageUrl}" />
                                        <VerticalStackLayout Grid.Row="1" Padding="10,5">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding Name}" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label
                                                    FontFamily="{StaticResource MaterialIconsFont}"
                                                    FontSize="12"
                                                    Text="&#xE55F;"
                                                    TextColor="Gray"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding City}"
                                                    TextColor="Gray" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=RecommendedBeachSelectedCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <!--  After Popular Beaches CollectionView  -->
        <VerticalStackLayout Padding="20,20,20,0" Spacing="20">
            <!--  Recommended Beaches Section Header  -->

        </VerticalStackLayout>

        <!--  Bottom Navigation Bar  -->
        <Grid
            Grid.Row="1"
            BackgroundColor="White"
            ColumnDefinitions="*,*,*"
            HeightRequest="60">
            <!--  Home  -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE88A;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHomeCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Home"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Weather  -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE2BD;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToWeatherCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Weather"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Map  -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE55B;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Map"
                    TextColor="#1B4965" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

    <!--  After Popular Beaches CollectionView  -->
    <!--  Recommended Beaches Section  -->

</ContentPage>