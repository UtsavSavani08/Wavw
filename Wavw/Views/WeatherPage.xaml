<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.WeatherPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:Wavw.Services"
    xmlns:views="clr-namespace:Wavw.Views"
    xmlns:converters="clr-namespace:Wavw.Converters"
    x:DataType="views:CompositeBindingContext"
    Title="Weather"
    BackgroundColor="#F4F4F4">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BooleanInvertConverter x:Key="BooleanInvertConverter"/>
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Margin" Value="16,8"/>
                <Setter Property="HasShadow" Value="True"/>
            </Style>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#1B4965"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="ValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="TextColor" Value="#1B4965"/>
            </Style>
            <Style x:Key="SubLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="#666666"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Search Bar -->
        <Frame Grid.Row="0" 
               Style="{StaticResource CardStyle}"
               Margin="16,16,16,8"
               Padding="16,0"
               CornerRadius="28"
               HeightRequest="56">
            <SearchBar
                Placeholder="Search beach by name..."
                SearchCommand="{Binding ViewModel.SearchCommand}"
                SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}"
                BackgroundColor="Transparent"
                CancelButtonColor="#1B4965"
                Margin="-16,0"/>
        </Frame>

        <!-- Weather Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ViewModel.HasBeachSelected}">
                <!-- Beach Name -->
                <Frame Style="{StaticResource CardStyle}">
                    <Label
                        Text="{Binding ViewModel.BeachName}"
                        Style="{StaticResource HeaderLabelStyle}"/>
                </Frame>

                <!-- Current Conditions -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="20">
                        <Label
                            Text="Current Conditions"
                            Style="{StaticResource HeaderLabelStyle}"/>

                        <!-- Wave Height -->
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="4">
                            <Label
                                Grid.Column="0"
                                Text="&#xE186;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                TextColor="#1B4965"
                                FontSize="24"
                                Margin="0,0,16,0"
                                VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Wave Height"
                                    Style="{StaticResource SubLabelStyle}"/>
                                <Label
                                    Text="{Binding ViewModel.WaveHeight, StringFormat='{0:F1} meters'}"
                                    Style="{StaticResource ValueLabelStyle}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Sea Temperature -->
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="4">
                            <Label
                                Grid.Column="0"
                                Text="&#xE1FF;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                TextColor="#1B4965"
                                FontSize="24"
                                Margin="0,0,16,0"
                                VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Sea Temperature"
                                    Style="{StaticResource SubLabelStyle}"/>
                                <Label
                                    Text="{Binding ViewModel.SeaTemperature, StringFormat='{0:F1}°C'}"
                                    Style="{StaticResource ValueLabelStyle}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Wind Conditions -->
                        <Grid ColumnDefinitions="Auto,*" RowSpacing="4">
                            <Label
                                Grid.Column="0"
                                Text="&#xE430;"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                TextColor="#1B4965"
                                FontSize="24"
                                Margin="0,0,16,0"
                                VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Wind Conditions"
                                    Style="{StaticResource SubLabelStyle}"/>
                                <Label
                                    Text="{Binding ViewModel.WindConditions}"
                                    Style="{StaticResource ValueLabelStyle}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Last Updated -->
                <Label
                    Text="{Binding ViewModel.LastUpdated, StringFormat='Last Updated: {0:g}'}"
                    Style="{StaticResource SubLabelStyle}"
                    Margin="16,8"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- No Beach Selected Message -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding ViewModel.HasBeachSelected, Converter={StaticResource BooleanInvertConverter}}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="16"
            Padding="20">
            <Label
                Text="&#xE2DB;"
                FontFamily="{StaticResource MaterialIconsFont}"
                TextColor="#1B4965"
                FontSize="48"
                HorizontalOptions="Center"/>
            <Label
                Text="Search for a beach to view weather information"
                Style="{StaticResource SubLabelStyle}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Bottom Navigation Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" BackgroundColor="White" HeightRequest="60">
            <!-- Home -->
            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE88A;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToHomeCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Home"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Weather -->
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE9CA;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToWeatherCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Weather"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Map -->
            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Label 
                    Text="&#xE55B;"
                    FontFamily="{StaticResource MaterialIconsFont}"
                    TextColor="#1B4965"
                    FontSize="24"
                    HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToMapCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label 
                    Text="Map"
                    TextColor="#1B4965"
                    FontSize="12"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage> 