<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wavw.Views.WeatherPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Wavw.Converters"
    xmlns:services="clr-namespace:Wavw.Services"
    xmlns:views="clr-namespace:Wavw.Views"
    Title="Weather"
    x:DataType="views:CompositeBindingContext"
    BackgroundColor="#F4F4F4">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BooleanInvertConverter x:Key="BooleanInvertConverter" />
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Margin" Value="16,8" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="BorderColor" Value="#E0E0E0" />
            </Style>
            <Style x:Key="WeatherIconStyle" TargetType="Image">
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="WidthRequest" Value="50" />
                <Setter Property="Aspect" Value="AspectFit" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#1B4965" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="ValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="#1B4965" />
            </Style>
            <Style x:Key="SubLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#666666" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Search Bar  -->
        <Frame
            Grid.Row="0"
            Margin="16,16,16,0"
            Padding="16,0"
            BackgroundColor="White"
            CornerRadius="30"
            HeightRequest="50">
            <SearchBar
                Margin="-16,0"
                BackgroundColor="Transparent"
                CancelButtonColor="#1B4965"
                Placeholder="Search beach by name..."
                SearchCommand="{Binding ViewModel.SearchCommand}"
                SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" />
        </Frame>
        <StackLayout
            Grid.Row="0"
            Margin="16,0,16,16"
            Orientation="Horizontal">
            
        </StackLayout>

        <!--  Main Content  -->
        <ScrollView x:Name="MainContent" Grid.Row="1">
            <VerticalStackLayout
                Padding="16"
                IsVisible="{Binding ViewModel.HasBeachSelected}"
                Spacing="16">
                <!--  Beach Name  -->
                <Label Style="{StaticResource HeaderLabelStyle}" Text="{Binding ViewModel.BeachName}" />

                <!--  Current Conditions  -->
                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource HeaderLabelStyle}" Text="Current Conditions" />

                        <!--  Wave Height  -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE176;"
                                TextColor="#1B4965" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource SubLabelStyle}" Text="Wave Height" />
                                <Label Style="{StaticResource ValueLabelStyle}" Text="{Binding ViewModel.WaveHeight, StringFormat='{0:F1} meters'}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!--  Sea Temperature  -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xE1FF;"
                                TextColor="#1B4965" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource SubLabelStyle}" Text="Sea Temperature" />
                                <Label Style="{StaticResource ValueLabelStyle}" Text="{Binding ViewModel.SeaTemperature, StringFormat='{0:F1}°C'}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!--  Wind Conditions  -->
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                FontFamily="{StaticResource MaterialIconsFont}"
                                FontSize="24"
                                Text="&#xEC0C;"
                                TextColor="#1B4965" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Style="{StaticResource SubLabelStyle}" Text="Wind Conditions" />
                                <Label Style="{StaticResource ValueLabelStyle}" Text="{Binding ViewModel.WindConditions}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>


                </Frame>
                <!--  Weather Forecast  -->
                <Frame x:Name="ForcastSection" Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource HeaderLabelStyle}" Text="Forecasts " />


                        

                        <ActivityIndicator
                            IsRunning="{Binding ViewModel.IsLoadingForecast}"
                            IsVisible="{Binding ViewModel.IsLoadingForecast}"
                            Color="#1B4965" />
                        <!--  Forecast Loading Indicator  -->

                        <ActivityIndicator
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            IsRunning="{Binding ViewModel.IsLoadingForecast}"
                            IsVisible="{Binding ViewModel.IsLoadingForecast}"
                            WidthRequest="50"
                            Color="#1B4965" />

                        <!--  Forecast Container  -->
                        <VerticalStackLayout x:Name="ForecastContainer" Spacing="10">
                            <!--  Forecast items will be added here programmatically  -->
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!--  Last Updated  -->
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource SubLabelStyle}"
                    Text="{Binding ViewModel.LastUpdated, StringFormat='Last Updated: {0:g}'}" />

                <!--  Loading Indicator  -->
                <ActivityIndicator
                    IsRunning="{Binding ViewModel.IsLoading}"
                    IsVisible="{Binding ViewModel.IsLoading}"
                    Color="#1B4965" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  No Beach Selected Message  -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="20"
            HorizontalOptions="Center"
            IsVisible="{Binding ViewModel.HasBeachSelected, Converter={StaticResource BooleanInvertConverter}}"
            Spacing="16"
            VerticalOptions="Center">
            <Label
                FontFamily="{StaticResource MaterialIconsFont}"
                FontSize="48"
                HorizontalOptions="Center"
                Text="&#xE2DB;"
                TextColor="#1B4965" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource SubLabelStyle}"
                Text="Search for a beach to view weather information" />
        </VerticalStackLayout>

        <!--  Bottom Navigation  -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            ColumnDefinitions="*,*,*"
            HeightRequest="60">

            <!--  Home  -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE88A;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToHomeCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Home"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Weather  -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE2BD;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToWeatherCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Weather"
                    TextColor="#1B4965" />
            </VerticalStackLayout>

            <!--  Map  -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="4"
                VerticalOptions="Center">
                <Label
                    FontFamily="{StaticResource MaterialIconsFont}"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="&#xE55B;"
                    TextColor="#1B4965">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigationCommands.NavigateToMapCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="Map"
                    TextColor="#1B4965" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>